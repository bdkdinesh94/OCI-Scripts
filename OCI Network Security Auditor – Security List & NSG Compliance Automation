    log ""

    log "Generating HTML security report..."


    local STATUS


    if [ "$SECURITY_SCORE" -ge 90 ]; then

        STATUS="GOOD"

    elif [ "$SECURITY_SCORE" -ge 75 ]; then

        STATUS="MODERATE"

    elif [ "$SECURITY_SCORE" -ge 50 ]; then

        STATUS="NEEDS IMPROVEMENT"

    else

        STATUS="HIGH RISK"

    fi


    cat > "$HTML_FILE" <<EOF
