#!/bin/bash

# ============================================================
# OCI Cloud Guard Problem Trend Analyzer
#
# Version: 1.0
#
# Purpose:
#   Generate a historical Cloud Guard security problem trend
#   report using OCI CLI.
#
# Features:
#   - Historical problem analysis
#   - Severity distribution
#   - Daily trend
#   - Problem type analysis
#   - Detector type analysis
#   - Region analysis
#   - Compartment analysis
#   - Recurring problem detection
#   - CSV reports
#   - HTML dashboard
#   - Security observations
#
# IMPORTANT:
#   READ-ONLY TOOL
#
#   This script does NOT:
#       - Resolve problems
#       - Dismiss problems
#       - Trigger responders
#       - Modify Cloud Guard configuration
#
# Requirements:
#   - OCI CLI
#   - jq
#   - Bash 4+
#
# ============================================================


# ============================================================
# CONFIGURATION
# ============================================================

COMPARTMENT_ID="<COMPARTMENT_OCID>"

REGION="<OCI_REPORTING_REGION>"

# Analysis period
DAYS=30

OUTPUT_DIR="./oci_cloud_guard_trend_reports"

RAW_FILE="$OUTPUT_DIR/cloud_guard_problems_raw.json"

TREND_FILE="$OUTPUT_DIR/cloud_guard_trend.json"

PROBLEMS_CSV="$OUTPUT_DIR/cloud_guard_problems.csv"

TREND_CSV="$OUTPUT_DIR/cloud_guard_daily_trend.csv"

SUMMARY_CSV="$OUTPUT_DIR/cloud_guard_summary.csv"

HTML_FILE="$OUTPUT_DIR/cloud_guard_trend_report.html"

LOG_FILE="$OUTPUT_DIR/cloud_guard_trend.log"


# ============================================================
# OUTPUT DIRECTORY
# ============================================================

mkdir -p "$OUTPUT_DIR"


# ============================================================
# COUNTERS
# ============================================================

TOTAL_PROBLEMS=0

CRITICAL_COUNT=0
HIGH_COUNT=0
MEDIUM_COUNT=0
LOW_COUNT=0
MINOR_COUNT=0

OPEN_COUNT=0
RESOLVED_COUNT=0
DISMISSED_COUNT=0


# ============================================================
# LOGGING
# ============================================================

log() {

    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" |
        tee -a "$LOG_FILE"

}


# ============================================================
# DEPENDENCY CHECK
# ============================================================

if ! command -v oci >/dev/null 2>&1; then

    log "ERROR: OCI CLI is not installed."

    exit 1

fi


if ! command -v jq >/dev/null 2>&1; then

    log "ERROR: jq is not installed."

    exit 1

fi


# ============================================================
# CONFIGURATION VALIDATION
# ============================================================

if [ "$COMPARTMENT_ID" = "<COMPARTMENT_OCID>" ]; then

    log "ERROR: COMPARTMENT_ID is not configured."

    exit 1

fi


if [ "$REGION" = "<OCI_REPORTING_REGION>" ]; then

    log "ERROR: REGION is not configured."

    exit 1

fi


# ============================================================
# DATE RANGE
# ============================================================

END_DATE=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

START_DATE=$(date -u -d "$DAYS days ago" \
    '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)


# macOS fallback
if [ -z "$START_DATE" ]; then

    START_DATE=$(date -u -v-"${DAYS}"d \
        '+%Y-%m-%dT%H:%M:%SZ')

fi


# ============================================================
# HEADER
# ============================================================

log "============================================================"

log "OCI CLOUD GUARD PROBLEM TREND ANALYZER"

log "============================================================"

log "Compartment : $COMPARTMENT_ID"

log "Region      : $REGION"

log "Period      : $START_DATE"

log "To          : $END_DATE"

log "Days        : $DAYS"

log "============================================================"


# ============================================================
# CSV HEADERS
# ============================================================

echo "Problem OCID,Problem Name,Risk Level,Status,Detector Type,Resource Type,Resource OCID,Compartment OCID,Region,First Detected,Last Detected" \
    > "$PROBLEMS_CSV"


echo "Date,Total,Critical,High,Medium,Low,Minor" \
    > "$TREND_CSV"


echo "Category,Value,Count" \
    > "$SUMMARY_CSV"


# ============================================================
# FETCH CLOUD GUARD TREND DATA
# ============================================================

log ""

log "Requesting Cloud Guard trend data..."


oci cloud-guard problem-trend-aggregation \
    request-summarized-trend-problems \
    --compartment-id "$COMPARTMENT_ID" \
    --time-first-detected-start "$START_DATE" \
    --time-first-detected-end "$END_DATE" \
    --region "$REGION" \
    > "$TREND_FILE" 2>/dev/null


if [ $? -ne 0 ]; then

    log "WARNING: Trend aggregation request failed."

    log "The CLI/API version may expose different trend parameters."

    echo '{}' > "$TREND_FILE"

fi


# ============================================================
# FETCH PROBLEM LIST
# ============================================================

log ""

log "Retrieving Cloud Guard problems..."


oci cloud-guard problem list \
    --compartment-id "$COMPARTMENT_ID" \
    --region "$REGION" \
    --all \
    > "$RAW_FILE" 2>/dev/null


if [ $? -ne 0 ]; then

    log "ERROR: Unable to retrieve Cloud Guard problems."

    exit 1

fi


# ============================================================
# PROBLEM COUNT
# ============================================================

TOTAL_PROBLEMS=$(jq '.data | length' "$RAW_FILE")


log "Problems retrieved: $TOTAL_PROBLEMS"


# ============================================================
# PROCESS PROBLEMS
# ============================================================

jq -c '.data[]?' "$RAW_FILE" |
while read -r PROBLEM
do

    PROBLEM_ID=$(echo "$PROBLEM" |
        jq -r '.id // ""')


    PROBLEM_NAME=$(echo "$PROBLEM" |
        jq -r '."problem-name" // .name // "Unknown"')


    RISK_LEVEL=$(echo "$PROBLEM" |
        jq -r '."risk-level" // .riskLevel // "UNKNOWN"')


    STATUS=$(echo "$PROBLEM" |
        jq -r '.status // ."lifecycle-state" // "UNKNOWN"')


    DETECTOR_TYPE=$(echo "$PROBLEM" |
        jq -r '."detector-type" // .detectorType // "UNKNOWN"')


    RESOURCE_TYPE=$(echo "$PROBLEM" |
        jq -r '."resource-type" // .resourceType // "UNKNOWN"')


    RESOURCE_ID=$(echo "$PROBLEM" |
        jq -r '."resource-id" // .resourceId // "UNKNOWN"')


    PROBLEM_COMPARTMENT=$(echo "$PROBLEM" |
        jq -r '."compartment-id" // .compartmentId // "UNKNOWN"')


    PROBLEM_REGION=$(echo "$PROBLEM" |
        jq -r '.region // "UNKNOWN"')


    FIRST_DETECTED=$(echo "$PROBLEM" |
        jq -r '."time-first-detected" // .timeCreated // "UNKNOWN"')


    LAST_DETECTED=$(echo "$PROBLEM" |
        jq -r '."time-last-detected" // .timeUpdated // "UNKNOWN"')


    # --------------------------------------------------------
    # Severity counters
    # --------------------------------------------------------

    case "$RISK_LEVEL" in

        CRITICAL)
            CRITICAL_COUNT=$((CRITICAL_COUNT + 1))
            ;;

        HIGH)
            HIGH_COUNT=$((HIGH_COUNT + 1))
            ;;

        MEDIUM)
            MEDIUM_COUNT=$((MEDIUM_COUNT + 1))
            ;;

        LOW)
            LOW_COUNT=$((LOW_COUNT + 1))
            ;;

        MINOR)
            MINOR_COUNT=$((MINOR_COUNT + 1))
            ;;

    esac


    # --------------------------------------------------------
    # Status counters
    # --------------------------------------------------------

    case "$STATUS" in

        OPEN|ACTIVE)
            OPEN_COUNT=$((OPEN_COUNT + 1))
            ;;

        RESOLVED)
            RESOLVED_COUNT=$((RESOLVED_COUNT + 1))
            ;;

        DISMISSED)
            DISMISSED_COUNT=$((DISMISSED_COUNT + 1))
            ;;

    esac


    # --------------------------------------------------------
    # CSV
    # --------------------------------------------------------

    echo "\"$PROBLEM_ID\",\"$PROBLEM_NAME\",\"$RISK_LEVEL\",\"$STATUS\",\"$DETECTOR_TYPE\",\"$RESOURCE_TYPE\",\"$RESOURCE_ID\",\"$PROBLEM_COMPARTMENT\",\"$PROBLEM_REGION\",\"$FIRST_DETECTED\",\"$LAST_DETECTED\"" \
        >> "$PROBLEMS_CSV"


    # --------------------------------------------------------
    # Log
    # --------------------------------------------------------

    log "Problem: $PROBLEM_NAME | Risk: $RISK_LEVEL | Status: $STATUS"

done


# ============================================================
# SEVERITY SUMMARY
# ============================================================

echo "Severity,Critical" >> "$SUMMARY_CSV"
echo "Severity,High" >> "$SUMMARY_CSV"
echo "Severity,Medium" >> "$SUMMARY_CSV"
echo "Severity,Low" >> "$SUMMARY_CSV"
echo "Severity,Minor" >> "$SUMMARY_CSV"


# ============================================================
# PROBLEM TYPE SUMMARY
# ============================================================

log ""

log "============================================================"

log "TOP CLOUD GUARD PROBLEM TYPES"

log "============================================================"


jq -r '
.data[]? |
(."problem-name" // .name // "Unknown")
' "$RAW_FILE" |
sort |
uniq -c |
sort -nr |
head -20 |
while read -r COUNT NAME
do

    log "$COUNT | $NAME"

    echo "Problem Type,$NAME,$COUNT" \
        >> "$SUMMARY_CSV"

done


# ============================================================
# DETECTOR TYPE SUMMARY
# ============================================================

log ""

log "============================================================"

log "DETECTOR TYPE SUMMARY"

log "============================================================"


jq -r '
.data[]? |
(."detector-type" // .detectorType // "Unknown")
' "$RAW_FILE" |
sort |
uniq -c |
sort -nr |
while read -r COUNT DETECTOR
do

    log "$COUNT | $DETECTOR"

    echo "Detector Type,$DETECTOR,$COUNT" \
        >> "$SUMMARY_CSV"

done


# ============================================================
# REGION SUMMARY
# ============================================================

log ""

log "============================================================"

log "REGION SUMMARY"

log "============================================================"


jq -r '
.data[]? |
(.region // "Unknown")
' "$RAW_FILE" |
sort |
uniq -c |
sort -nr |
while read -r COUNT REGION_NAME
do

    log "$COUNT | $REGION_NAME"

    echo "Region,$REGION_NAME,$COUNT" \
        >> "$SUMMARY_CSV"

done


# ============================================================
# RESOURCE TYPE SUMMARY
# ============================================================

log ""

log "============================================================"

log "RESOURCE TYPE SUMMARY"

log "============================================================"


jq -r '
.data[]? |
(."resource-type" // .resourceType // "Unknown")
' "$RAW_FILE" |
sort |
uniq -c |
sort -nr |
while read -r COUNT RESOURCE
do

    log "$COUNT | $RESOURCE"

    echo "Resource Type,$RESOURCE,$COUNT" \
        >> "$SUMMARY_CSV"

done


# ============================================================
# RECURRING PROBLEM DETECTION
# ============================================================

log ""

log "============================================================"

log "RECURRING PROBLEM ANALYSIS"

log "============================================================"


jq -r '
.data[]? |
[
    (."problem-name" // .name // "Unknown"),
    (."resource-id" // .resourceId // "Unknown")
] |
@tsv
' "$RAW_FILE" |
sort |
uniq -c |
sort -nr |
head -20 |
while read -r COUNT PROBLEM RESOURCE
do

    if [ "$COUNT" -gt 1 ]; then

        log "Recurring: $COUNT occurrences | $PROBLEM | $RESOURCE"

        echo "Recurring Problem,$PROBLEM,$COUNT" \
            >> "$SUMMARY_CSV"

    fi

done


# ============================================================
# DAILY TREND
# ============================================================

log ""

log "============================================================"

log "GENERATING DAILY TREND"

log "============================================================"


jq -r '
.data[]? |
."time-first-detected" //
.timeCreated //
empty
' "$RAW_FILE" |
cut -c1-10 |
sort |
uniq -c |
while read -r COUNT DATE
do

    echo "$DATE,$COUNT,0,0,0,0,0" \
        >> "$TREND_CSV"

done


# ============================================================
# SECURITY OBSERVATIONS
# ============================================================

OBSERVATIONS_FILE="$OUTPUT_DIR/security_observations.txt"


cat > "$OBSERVATIONS_FILE" <<EOF

OCI CLOUD GUARD SECURITY OBSERVATIONS
=====================================

Analysis Period:
$START_DATE
to
$END_DATE


TOTAL PROBLEMS:
$TOTAL_PROBLEMS


SEVERITY DISTRIBUTION:
Critical : $CRITICAL_COUNT
High     : $HIGH_COUNT
Medium   : $MEDIUM_COUNT
Low      : $LOW_COUNT
Minor    : $MINOR_COUNT


STATUS DISTRIBUTION:
Open      : $OPEN_COUNT
Resolved  : $RESOLVED_COUNT
Dismissed : $DISMISSED_COUNT


INTERPRETATION:

1. Review recurring problem types to identify repeated
   configuration or security issues.

2. Review Critical and High risk problems first according
   to the organization's remediation process.

3. Compare problem volume over time to identify increasing
   or decreasing security findings.

4. Review affected resource types to identify services
   that generate repeated Cloud Guard findings.

5. Review detector types to understand whether findings
   are primarily configuration, activity, threat or
   instance-security related.

6. Validate recurring findings with resource owners before
   making remediation changes.


IMPORTANT:

This report is informational and does not automatically
change Cloud Guard problems or OCI resources.

EOF


# ============================================================
# HTML REPORT
# ============================================================

log ""

log "Generating HTML dashboard..."


cat > "$HTML_FILE" <<EOF

