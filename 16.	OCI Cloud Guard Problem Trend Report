# ============================================================
# FINAL SUMMARY
# ============================================================

log ""

log "============================================================"

log "CLOUD GUARD TREND REPORT COMPLETED"

log "============================================================"

log "Total Problems       : $TOTAL_PROBLEMS"

log "Critical             : $CRITICAL_COUNT"

log "High                 : $HIGH_COUNT"

log "Medium               : $MEDIUM_COUNT"

log "Low                  : $LOW_COUNT"

log "Minor                : $MINOR_COUNT"

log "Open                 : $OPEN_COUNT"

log "Resolved             : $RESOLVED_COUNT"

log "Dismissed            : $DISMISSED_COUNT"

log "------------------------------------------------------------"

log "Problem CSV          : $PROBLEMS_CSV"

log "Trend CSV            : $TREND_CSV"

log "Summary CSV          : $SUMMARY_CSV"

log "HTML Report          : $HTML_FILE"

log "Observations         : $OBSERVATIONS_FILE"

log "Log                  : $LOG_FILE"

log "============================================================"


